# Step 1: Build the artifact using Maven
FROM maven:3.9.6-eclipse-temurin-21-alpine AS build
WORKDIR /app
COPY . .
RUN mvn clean package -DskipTests

# Step 2: Use a lightweight JRE image to run the app
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# Copy the built jar file from the previous step
COPY --from=build /app/target/*.jar app.jar

# Vercel needs your application to listen on port 80 or the assigned $PORT
EXPOSE 80
CMD ["java", "-jar", "app.jar"]